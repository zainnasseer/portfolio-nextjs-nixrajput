# Neon Postgres (neon init / neon deploy populate these in .env.local)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Auth.js + admin (GitHub OAuth)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_LOGIN=

# Optional: higher GitHub rate limits + GraphQL stats (stars across all repos)
GITHUB_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:4000